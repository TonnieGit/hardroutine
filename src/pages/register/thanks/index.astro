---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MegaHeading from '../../../components/MegaHeading.astro';
---
<BaseLayout
  title="You're on the list | Hard Routine"
  description="Thanks for registering your interest in Hard Routine. We'll be in touch when the range launches."
  path="/register/thanks/"
  noindex={true}
>
  <article class="wrap section prose">
    <MegaHeading as="h1" size="md" lines={["You're on", 'the list']} />
    <p class="lede">
      Thanks. We've got your email and you'll hear from us when the range
      is ready.
    </p>
    <p>
      Nothing else to do for now. If you want to see what we're building in
      the meantime, the <a href="/field-notes/">Field Notes</a> are worth a
      read.
    </p>
  </article>
</BaseLayout>

<style>
  .prose :global(.mega-heading) { margin-bottom: var(--space-2); }
  .lede { font-size: 18px; color: var(--bone-muted); }
</style>
