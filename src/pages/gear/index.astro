---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import ProductSystem from '../../components/ProductSystem.astro';
import { site } from '../../lib/site';
---
<BaseLayout
  title="Gear | Hard Routine"
  description="Swag transit bags, duffle bags and rear wheel bags in blackout technical nylon. Australian designed, built around the failures that ruin good gear. Launching early 2027."
  path="/gear/"
>
  <Breadcrumbs crumbs={[
    { name: 'Home', item: `${site.url}/` },
    { name: 'Gear' },
  ]} />

  <section class="section-black gear-intro">
    <div class="wrap">
      <SectionLabel label="SYSTEM" index="00" />
      <h1>Gear</h1>
      <p class="prose lede">
        Three categories, one fabric, one reason for each design decision. Every
        bag in the range is built around a documented failure in the gear it
        replaces — see <a href="/the-fabric/">The Fabric</a> for the material,
        or <a href="/about/">About</a> for how we got here.
      </p>
      <h2>Three things, done properly</h2>
    </div>
  </section>

  <div class="wrap">
    <ProductSystem
      line="ROLL"
      index="01"
      descriptor="SWAG TRANSIT BAGS / 900 · 1200 · 1400 MM"
      href="/gear/swag-bags/"
      linkLabel="Swag bags →"
      imageBasePath="/img/roll-feature-loadup"
      variant="image-left"
    >
      Oversized, vented swag transit bags in three sizes. Cut for a wet swag
      rolled badly, not a dry one rolled well.
    </ProductSystem>
    <ProductSystem
      line="HAUL"
      index="02"
      descriptor="DUFFLE BAGS / 40 · 70 · 100 L"
      href="/gear/duffle-bags/"
      linkLabel="Duffle bags →"
      imageBasePath="/img/haul-feature-loadup"
      variant="image-right"
    >
      Touring duffles in coated technical nylon. Lighter than canvas, water
      resistant, won't mildew.
    </ProductSystem>
    <ProductSystem
      line="DUMP"
      index="03"
      descriptor="REAR WHEEL BAGS / 60 · 90 L"
      href="/gear/rear-wheel-bags/"
      linkLabel="Rear wheel bags →"
      imageBasePath="/img/dump-feature-spare"
      variant="image-left"
    >
      Welded-liner spare wheel bags for the gear you don't want inside the
      vehicle. Real drainage, webbing that holds.
    </ProductSystem>
  </div>
</BaseLayout>

<style>
  .gear-intro { padding-block: var(--space-6) var(--space-4); }
  .lede {
    margin-top: var(--space-3);
    font-size: 18px;
    color: var(--bone-muted);
  }
  .gear-intro h2 { margin-top: var(--space-6); }
</style>
