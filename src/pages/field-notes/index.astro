---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import MegaHeading from '../../components/MegaHeading.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { site } from '../../lib/site';

const entries = (await getCollection('field-notes')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const [featured, ...rest] = entries;
const dateFmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout
  title="Field Notes — 4WD Storage & Camping Gear Guides | Hard Routine"
  description="Practical guides on camping gear storage — stopping mould in canvas, choosing a swag bag, storing dirty recovery gear, and why zips fail in Australian dust."
  path="/field-notes/"
>
  <Breadcrumbs crumbs={[
    { name: 'Home', item: `${site.url}/` },
    { name: 'Field Notes' },
  ]} />

  <ImageSlot
    slotName="LIFESTYLE-SWAG-PACKUP"
    basePath="/img/lifestyle-swag-packup"
    width={1376}
    height={768}
    alt=""
    minHeight="70svh"
    fullBleed
    class="field-notes-hero"
  >
    <div class="wrap">
      <SectionLabel label="FIELD NOTES" index="00" light />
      <MegaHeading as="h1" size="lg" lines={['Field', 'Notes']} />
    </div>
  </ImageSlot>

  <section class="section-black field-notes-intro">
    <div class="wrap">
      <p class="prose intro">
        Practical writing on gear storage, based on what actually fails. No
        listicles, no affiliate roundups.
      </p>
    </div>
  </section>

  {featured && (
    <div class="wrap">
      <a href={`/field-notes/${featured.id}/`} class="featured-article">
        <div class="featured-image">
          <ResponsiveImage
            basePath={`/img/field-notes/${featured.id}`}
            width={1200}
            height={630}
            alt=""
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="featured-body">
          <p class="mono-label featured-index">FIELD NOTES / 01</p>
          <MegaHeading as="h2" size="md" lines={[featured.data.title]} />
          <p class="featured-standfirst">{featured.data.standfirst}</p>
          <p class="mono-label article-meta">
            {featured.data.readingTime} read · {dateFmt(featured.data.publishDate)}
          </p>
          <span class="btn btn-ghost">Read field note →</span>
        </div>
      </a>
    </div>
  )}

  <div class="wrap">
    <ul class="article-list">
      {rest.map((entry) => (
        <li>
          <a href={`/field-notes/${entry.id}/`} class="article-row">
            <div class="article-row-image">
              <ResponsiveImage
                basePath={`/img/field-notes/${entry.id}`}
                width={600}
                height={315}
                alt=""
                loading="lazy"
              />
            </div>
            <div class="article-row-body">
              <h2>{entry.data.title}</h2>
              <p class="standfirst">{entry.data.standfirst}</p>
              <p class="mono-label article-meta">
                {entry.data.readingTime} read · {dateFmt(entry.data.publishDate)}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .field-notes-intro { padding-block: var(--space-6) var(--space-4); }
  .intro { font-size: 18px; color: var(--bone-muted); }

  .featured-article {
    display: block;
    text-decoration: none;
    color: var(--bone);
    margin-block: var(--space-5);
  }
  .featured-index { color: var(--brass); }
  .featured-image { line-height: 0; }
  .featured-image :global(img) { width: 100%; height: auto; display: block; }
  .featured-body { margin-top: var(--space-3); }
  .featured-body :global(.mega-heading) { margin-top: var(--space-1); }
  .featured-standfirst {
    margin-top: var(--space-2);
    max-width: 60ch;
    font-size: 18px;
    color: var(--bone-muted);
  }
  .article-meta { margin-top: var(--space-2); }
  .featured-article .btn { margin-top: var(--space-3); pointer-events: none; }

  .article-list {
    list-style: none;
    padding: 0;
    margin-block: var(--space-6);
  }
  .article-row {
    display: grid;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--bone);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .article-list li:last-child .article-row { border-bottom: 1px solid var(--line); }
  @media (min-width: 640px) {
    .article-row { grid-template-columns: 240px 1fr; align-items: center; }
  }
  .article-row-image { line-height: 0; }
  .article-row-image :global(img) { width: 100%; height: auto; display: block; }
  .article-row h2 { font-size: 24px; }
  .article-row:hover h2 { color: var(--brass); }
  .standfirst { margin-top: var(--space-1); color: var(--lichen); }
</style>
