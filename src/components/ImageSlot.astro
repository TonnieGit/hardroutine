---
// A defined image slot for cinematic/lifestyle photography that does not
// exist yet (see hard-routine-design-brief.md §41-42). Until a real
// `basePath` is supplied, this renders as a clearly-marked placeholder —
// dark ground, thin rule, mono slot name — so it reads as "photography
// pending" rather than a finished graphic. Swap in `basePath` later with
// no markup change elsewhere.
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  slotName: string;
  alt?: string;
  basePath?: string;
  width?: number;
  height?: number;
  ratio?: string; // CSS aspect-ratio value, e.g. "16 / 9"
  minHeight?: string; // overrides ratio-based sizing, e.g. "100svh"
  fullBleed?: boolean;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  slotName,
  alt = '',
  basePath,
  width = 1600,
  height = 900,
  ratio = '16 / 9',
  minHeight,
  fullBleed = false,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
} = Astro.props;
---
<div
  class:list={['image-slot', fullBleed && 'full-bleed', className]}
  style={minHeight ? `min-height:${minHeight}` : `aspect-ratio:${ratio}`}
>
  {basePath ? (
    <ResponsiveImage
      basePath={basePath}
      width={width}
      height={height}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      class="image-slot-media"
    />
  ) : (
    <div class="image-slot-placeholder" role={alt ? 'img' : undefined} aria-label={alt || undefined}>
      <span class="mono-label image-slot-name">{slotName}</span>
    </div>
  )}
  {Astro.slots.has('default') && (
    <div class="image-slot-overlay">
      <slot />
    </div>
  )}
</div>

<style>
  .image-slot {
    position: relative;
    overflow: hidden;
    background: var(--bitumen);
  }
  /* :global — .image-slot-media is applied to the <img> rendered inside the
     child ResponsiveImage component, which Astro's scoped styles don't reach. */
  :global(.image-slot-media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Edge vignette — always present, independent of the text scrim below,
     so every photo (not just ones carrying an overlay) reads darker and
     more contained at the frame edges instead of flat/bright corner to
     corner. Sits above the image, below the text overlay (z-index 2). */
  .image-slot::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      120% 120% at 50% 45%,
      rgba(10, 11, 10, 0) 45%,
      rgba(10, 11, 10, 0.5) 100%
    );
  }
  .image-slot-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-3);
    border: 1px solid var(--line);
    background:
      repeating-linear-gradient(
        135deg,
        var(--char) 0px,
        var(--char) 1px,
        var(--bitumen) 1px,
        var(--bitumen) 28px
      );
  }
  .image-slot-name {
    color: var(--lichen);
  }
  .image-slot-overlay {
    /* absolute + inset:0, not height:100% — the parent is sized by
       min-height/aspect-ratio, not a definite height, so a percentage
       height here would resolve against its own content instead of the
       full image and collapse to just the text band, cutting the scrim
       off hard partway up the photo. */
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-4) var(--space-3);
  }
  /* Scrim across the full image, not just behind the text — gentle at the
     top, darkening hard toward the bottom edge where the text sits, for a
     harder-contrast, grittier read than a soft editorial fade. */
  .image-slot-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(10, 11, 10, 0.94) 0%,
      rgba(10, 11, 10, 0.6) 32%,
      rgba(10, 11, 10, 0.18) 62%,
      rgba(10, 11, 10, 0.02) 100%
    );
  }
  @media (min-width: 640px) {
    .image-slot-overlay { padding: var(--space-5) var(--space-4); }
  }
</style>
