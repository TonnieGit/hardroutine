---
// Asymmetric overlap composition — the text panel breaks over the image
// edge rather than sitting beside it in a clean split. See
// hard-routine-design-brief.md §21 SECTION 04 and §32 (asymmetry).
import MegaHeading from './MegaHeading.astro';
import ImageSlot from './ImageSlot.astro';

interface Props {
  line: string; // "HAUL"
  index: string; // "02"
  descriptor: string; // "DUFFLE BAGS / 40 · 70 · 100 L"
  href: string;
  linkLabel: string; // "Duffle bags →"
  imageBasePath?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  variant?: 'image-left' | 'image-right';
}
const {
  line,
  index,
  descriptor,
  href,
  linkLabel,
  imageBasePath,
  imageAlt = '',
  imageWidth = 1200,
  imageHeight = 896,
  variant = 'image-left',
} = Astro.props;
---
<article class:list={['product-system', variant]}>
  <ImageSlot
    slotName={`PRODUCT-${line}-FIELD`}
    basePath={imageBasePath}
    alt={imageAlt}
    ratio="4 / 3"
    class="product-system-image"
    width={imageWidth}
    height={imageHeight}
  />
  <div class="product-system-body">
    <p class="mono-label product-system-index">{index}</p>
    <MegaHeading lines={[line]} size="lg" as="h3" />
    <p class="mono-label product-system-descriptor">{descriptor}</p>
    <p class="product-system-copy"><slot /></p>
    <a href={href} class="btn btn-ghost">{linkLabel}</a>
  </div>
</article>

<style>
  .product-system {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: var(--space-3);
    padding-block: var(--space-4);
  }
  /* :global — .product-system-image is the root of the child ImageSlot
     component, which doesn't carry this component's scope attribute. */
  .product-system :global(.product-system-image) {
    grid-column: 1 / 13;
  }
  .product-system-body {
    grid-column: 1 / 13;
    background: var(--bitumen);
    padding-block: var(--space-3) 0;
    position: relative;
    z-index: 2;
  }
  @media (min-width: 860px) {
    .product-system { padding-block: var(--space-6); }
    /* Explicit grid-row on both items forces them onto the same row so the
       text panel can overlap the image's edge — without it, grid
       auto-placement pushes the second item to a new row to avoid the
       column overlap instead of layering it. */
    .product-system.image-left :global(.product-system-image) { grid-column: 1 / 9; grid-row: 1; }
    .product-system.image-left .product-system-body {
      grid-column: 7 / 13;
      grid-row: 1;
      align-self: end;
      padding: var(--space-4) 0 var(--space-2) var(--space-4);
    }
    .product-system.image-right :global(.product-system-image) { grid-column: 5 / 13; grid-row: 1; }
    .product-system.image-right .product-system-body {
      grid-column: 1 / 7;
      grid-row: 1;
      align-self: start;
      padding: 0 var(--space-4) var(--space-2) 0;
      text-align: right;
    }
    .product-system.image-right .product-system-body .btn { margin-inline-start: auto; }
  }
  .product-system-index {
    color: var(--brass);
    font-size: 15px;
    margin-bottom: var(--space-1);
  }
  .product-system-descriptor {
    margin-top: var(--space-1);
    color: var(--brass);
  }
  .product-system-copy {
    margin-top: var(--space-2);
    color: var(--bone-muted);
    max-width: 42ch;
  }
  .product-system.image-right .product-system-copy { margin-inline-start: auto; }
  .product-system-body .btn {
    margin-top: var(--space-3);
  }
</style>
